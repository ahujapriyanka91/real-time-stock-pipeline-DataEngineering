FINNHUB_API_KEY=your_finnhub_api_key_here
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock-quotes
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,META
POLL_INTERVAL_SECONDS=15

# Snowflake (step 4)
SNOWFLAKE_ACCOUNT=your_account_identifier_here
SNOWFLAKE_USER=PIPELINE_USER
SNOWFLAKE_ROLE=PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=STOCK_WH
SNOWFLAKE_DATABASE=STOCK_DB
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_rsa_key.p8

# dbt (step 6) - lets you run dbt from the project root
DBT_PROJECT_DIR=dbt_stocks
DBT_PROFILES_DIR=dbt_stocks

# Airflow (step 7) - generate your own values
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
